{
  "datasets": [
    {
      "name": "movies_per_year",
      "displayName": "Movies per Year Gold",
      "config": {
        "version": "1.1",
        "source": "workspace.default.movies_per_year_gold",
        "dimensions": [
          {
            "name": "release_year",
            "expr": "release_year",
            "displayName": "Release Year",
            "comment": "Year the movie was released"
          }
        ],
        "measures": [
          {
            "name": "movie_count",
            "expr": "SUM(movie_count)",
            "displayName": "Movie Count",
            "comment": "Total number of movies released"
          }
        ]
      }
    },
    {
      "name": "user_stats",
      "displayName": "User Stats Gold",
      "config": {
        "version": "1.1",
        "source": "workspace.default.user_stats_gold",
        "dimensions": [
          {
            "name": "userId",
            "expr": "userId",
            "displayName": "User ID",
            "comment": "Unique user identifier"
          },
          {
            "name": "age",
            "expr": "age",
            "displayName": "Age",
            "comment": "Age group code"
          },
          {
            "name": "gender",
            "expr": "gender",
            "displayName": "Gender",
            "comment": "User gender (M/F)"
          },
          {
            "name": "occupation",
            "expr": "occupation",
            "displayName": "Occupation",
            "comment": "User occupation"
          }
        ],
        "measures": [
          {
            "displayName": "Avg Rating",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_rating",
            "expr": "AVG(avg_rating)",
            "comment": "Average rating given by user"
          },
          {
            "name": "num_ratings",
            "expr": "SUM(num_ratings)",
            "displayName": "Total Ratings",
            "comment": "Total number of ratings by user"
          },
          {
            "name": "user_count",
            "expr": "COUNT(DISTINCT userId)",
            "displayName": "User Count",
            "comment": "Count of distinct users"
          }
        ]
      }
    },
    {
      "name": "genre_counts",
      "displayName": "Genre Counts Gold",
      "config": {
        "version": "1.1",
        "source": "workspace.default.genre_counts_gold",
        "dimensions": [
          {
            "name": "genre",
            "expr": "genre",
            "displayName": "Genre",
            "comment": "Movie genre category"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "SUM(count)",
            "displayName": "Count",
            "comment": "Number of movies in this genre"
          }
        ]
      }
    },
    {
      "name": "movie_stats",
      "displayName": "Movie Stats Gold",
      "config": {
        "version": "1.1",
        "source": "workspace.default.movie_stats_gold",
        "dimensions": [
          {
            "name": "movieId",
            "expr": "movieId",
            "displayName": "Movie ID"
          },
          {
            "name": "title",
            "expr": "title",
            "displayName": "Title"
          },
          {
            "name": "genres",
            "expr": "genres",
            "displayName": "Genres"
          },
          {
            "name": "top_occupation",
            "expr": "top_occupation",
            "displayName": "Top Occupation",
            "comment": "Occupation group with highest average rating for this movie"
          }
        ],
        "measures": [
          {
            "displayName": "Avg Rating",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_rating",
            "expr": "AVG(avg_rating)",
            "comment": "Average rating across all users"
          },
          {
            "displayName": "Avg Age",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "avg_age",
            "expr": "AVG(avg_age)",
            "comment": "Average age of users who rated this movie"
          },
          {
            "displayName": "Top Occupation Avg Rating",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "top_occupation_avg_rating",
            "expr": "AVG(top_occupation_avg_rating)",
            "comment": "Average rating from the top occupation group"
          },
          {
            "name": "movie_count",
            "expr": "COUNT(DISTINCT movieId)",
            "displayName": "Movie Count",
            "comment": "Count of distinct movies"
          }
        ]
      }
    },
    {
      "name": "movie_stats_top_rated",
      "displayName": "Top Rated Movies Gold",
      "config": {
        "version": "1.1",
        "source": "SELECT movieId, title, genres, avg_rating, avg_age, top_occupation, top_occupation_avg_rating FROM workspace.default.movie_stats_gold ORDER BY avg_rating DESC LIMIT 20\n",
        "dimensions": [
          {
            "name": "title",
            "expr": "title",
            "displayName": "Title",
            "comment": "Movie title"
          },
          {
            "name": "genres",
            "expr": "genres",
            "displayName": "Genres"
          }
        ],
        "measures": [
          {
            "displayName": "Avg Rating",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_rating",
            "expr": "AVG(avg_rating)",
            "comment": "Average rating across all users"
          }
        ]
      }
    }
  ],
